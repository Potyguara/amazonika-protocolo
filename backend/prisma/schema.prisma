generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENTE
  ATENDENTE
  GERENTE
  PROGRAMADOR
}

enum ProtocolStatus {
  NOVO
  AGENDADO
  REUNIAO_REALIZADA
  PROPOSTA_ENVIADA
  ACORDO_FECHADO
  CONTRATO_ENVIADO
  AGUARDANDO_ASSINATURA
  CONTRATO_ASSINADO
  EM_EXECUCAO
  AGUARDANDO_DOCUMENTOS
  AGUARDANDO_ORGAO_PUBLICO
  FINALIZADO
  CANCELADO
}

enum AppointmentStatus {
  AGENDADO
  REAGENDADO
  REALIZADO
  CLIENTE_NAO_COMPARECEU
  CANCELADO
}

enum ContractStatus {
  GERADO
  ENVIADO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
  SUBSTITUIDO
}

enum PaymentStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum BillingStatus {
  RASCUNHO
  AGUARDANDO_DOCUMENTO_FISCAL
  PRONTA_PARA_EMISSAO
  EMITIDA
  ENVIADA
  PAGA
  VENCIDA
  CANCELADA
  ERRO
}

enum BillingProvider {
  BANCO_DO_BRASIL
  MANUAL
}

enum BillingChargeType {
  ENTRADA
  PARCELA
  AVULSA
}

enum BillingFiscalMode {
  NOTA_FISCAL_ANTES
  RECIBO_POSTERIOR
}

enum FiscalDocumentType {
  NOTA_FISCAL
  RECIBO
  COMPROVANTE
  OUTRO
}

enum FiscalDocumentMoment {
  PRE_COBRANCA
  POS_PAGAMENTO
}

enum FiscalDocumentStatus {
  ANEXADO
  CANCELADO
}

enum PublicRequestStatus {
  NOVA
  EM_ANALISE
  CONVERTIDA_EM_PROTOCOLO
  DESCARTADA
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  ACEITA
  RECUSADA
  AJUSTE_SOLICITADO
  EXPIRADA
  CONVERTIDA_EM_CONTRATO
  CANCELADA
}

enum ProposalPaymentMode {
  A_VISTA
  ENTRADA_PARCELAS
  PARCELADO
  PERSONALIZADO
}

enum CatalogPricingMode {
  FIXO
  POR_HECTARE
  POR_KM
  POR_UNIDADE
  POR_MODULO_FISCAL
  POR_DIARIA
  POR_HORA
  POR_FAIXA
  SOB_CONSULTA
}

model ServiceCategory {
  id Int @id @default(autoincrement())

  name        String
  code        String  @unique
  description String?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services CatalogService[]

  @@index([name])
  @@index([active])
  @@index([sortOrder])
}

model CatalogService {
  id Int @id @default(autoincrement())

  categoryId Int

  code    String  @unique
  name    String
  acronym String?

  shortDescription     String?
  proposalDescription  String?
  technicalDescription String?
  legalText            String?

  pricingMode CatalogPricingMode

  // Valores monetários sempre em centavos.
  baseAmount    Int  @default(0)
  minimumAmount Int?

  // Ex.: Serviço, ha, km, unidade, módulo fiscal, diária.
  unitLabel String?

  defaultExecutionDays Int?

  allowManualPrice Boolean @default(true)

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])

  pricingTiers            CatalogServicePricingTier[]
  packageItems            ServicePackageItem[]
  standaloneProposalItems StandaloneProposalItem[]
  financialTransactions   FinancialTransaction[]
  protocols               Protocol[]

  @@index([categoryId])
  @@index([name])
  @@index([active])
  @@index([pricingMode])
  @@index([sortOrder])
}

model CatalogServicePricingTier {
  id Int @id @default(autoincrement())

  serviceId Int

  minQuantity Float?
  maxQuantity Float?

  // Valor por unidade da faixa, em centavos.
  unitAmount Int

  // Piso mínimo opcional da faixa, em centavos.
  minimumAmount Int?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  service CatalogService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([sortOrder])
}

model ServicePackage {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  description         String?
  proposalDescription String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ServicePackageItem[]

  @@index([name])
  @@index([active])
}

model ServicePackageItem {
  id Int @id @default(autoincrement())

  packageId Int
  serviceId Int

  quantity  Float   @default(1)
  required  Boolean @default(true)
  sortOrder Int     @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  service CatalogService @relation(fields: [serviceId], references: [id])

  @@unique([packageId, serviceId])
  @@index([packageId])
  @@index([serviceId])
  @@index([sortOrder])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)

  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProtocols     Protocol[]    @relation("CreatedProtocols")
  responsibleProtocols Protocol[]    @relation("ResponsibleProtocols")
  managedAppointments  Appointment[] @relation("ManagerAppointments")

  financialTransactionsCreated FinancialTransaction[] @relation("FinancialTransactionCreatedBy")
  fixedCostsCreated            FixedCost[]            @relation("FixedCostCreatedBy")
  employeeSalariesCreated      EmployeeSalary[]       @relation("EmployeeSalaryCreatedBy")

  managementCashSettingsCreated ManagementCashSetting[] @relation("ManagementCashSettingCreatedBy")
  proLaboreAdvancesCreated      ProLaboreAdvance[]      @relation("ProLaboreAdvanceCreatedBy")
  managerProLaboreAdvances      ProLaboreAdvance[]      @relation("ManagerProLaboreAdvances")
  proposalsCreated              Proposal[]              @relation("ProposalCreatedBy")
  contractsCreated              Contract[]              @relation("ContractCreatedBy")
  billingChargesCreated         BillingCharge[]         @relation("BillingChargeCreatedBy")
  fiscalDocumentsCreated        FiscalDocument[]        @relation("FiscalDocumentCreatedBy")
  standaloneProposalsCreated    StandaloneProposal[]    @relation("StandaloneProposalCreatedBy")

  paymentDueDateExtensionsCreated   PaymentDueDateExtension[] @relation("PaymentDueDateExtensionCreatedBy")
  paymentDueDateExtensionsCancelled PaymentDueDateExtension[] @relation("PaymentDueDateExtensionCancelledBy")

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int

  // Nunca armazenamos o token puro.
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  requestIp        String?
  requestUserAgent String?

  usedIp        String?
  usedUserAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Client {
  id         Int     @id @default(autoincrement())
  name       String
  personType String?
  cpfCnpj    String?
  phone      String?
  whatsapp   String?
  email      String?
  address    String?
  city       String?
  state      String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols             Protocol[]
  appointments          Appointment[]
  documents             Document[]
  contracts             Contract[]
  payments              Payment[]
  proposals             Proposal[]
  billingCharges        BillingCharge[]
  fiscalDocuments       FiscalDocument[]
  standaloneProposals   StandaloneProposal[]
  financialTransactions FinancialTransaction[]
}

model ServiceType {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publicRequests PublicRequest[]
}

model Protocol {
  id                Int    @id @default(autoincrement())
  protocolNumber    String @unique
  clientId          Int
  serviceTypeId     Int
  createdByUserId   Int?
  responsibleUserId Int?

  status             ProtocolStatus      @default(NOVO)
  description        String?
  priority           String?
  estimatedValue     Float?
  finalValue         Float?
  deadlineDate       DateTime?
  closedAt           DateTime?
  finishedAt         DateTime?
  cancelReason       String?
  partnerCommissions PartnerCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client         @relation(fields: [clientId], references: [id])
  serviceType CatalogService @relation(fields: [serviceTypeId], references: [id])

  createdByUser   User? @relation("CreatedProtocols", fields: [createdByUserId], references: [id])
  responsibleUser User? @relation("ResponsibleProtocols", fields: [responsibleUserId], references: [id])

  appointments Appointment[]
  documents    Document[]
  contracts    Contract[]
  payments     Payment[]

  financialTransactions FinancialTransaction[]
  proposals             Proposal[]
  proposalHistories     ProposalHistory[]
  billingCharges        BillingCharge[]
  fiscalDocuments       FiscalDocument[]
}

model Appointment {
  id            Int  @id @default(autoincrement())
  protocolId    Int
  clientId      Int
  managerUserId Int?

  scheduledAt    DateTime
  scheduledEndAt DateTime
  timezone       String            @default("America/Belem")
  meetingType    String?
  location       String?
  meetingLink    String?
  status         AppointmentStatus @default(AGENDADO)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol Protocol @relation(fields: [protocolId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  manager  User?    @relation("ManagerAppointments", fields: [managerUserId], references: [id])
}

model Document {
  id               Int     @id @default(autoincrement())
  protocolId       Int?
  clientId         Int?
  uploadedByUserId Int?
  documentType     String
  fileName         String
  filePath         String
  mimeType         String?
  size             Int?
  notes            String?

  createdAt DateTime @default(now())

  protocol Protocol? @relation(fields: [protocolId], references: [id])
  client   Client?   @relation(fields: [clientId], references: [id])
}

enum PaymentDueDateExtensionStatus {
  ATIVA
  CANCELADA
  SUBSTITUIDA
}

model Contract {
  id Int @id @default(autoincrement())

  protocolId  Int
  clientId    Int
  proposalId  Int?
  createdById Int?

  contractNumber String @unique
  publicToken    String @unique

  templateType       String?
  status             ContractStatus      @default(GERADO)
  partnerCommissions PartnerCommission[]

  contractValue Float?
  entryAmount   Int?
  paymentMode   String?

  title           String?
  objectText      String?
  obligationsText String?
  paymentText     String?
  deadlineText    String?
  legalText       String?

  htmlSnapshot     String?
  generatedPdfPath String?
  signedPdfPath    String?

  sentToClientAt DateTime?
  signedAt       DateTime?

  signerName      String?
  signerCpfCnpj   String?
  signerEmail     String?
  signerIp        String?
  signerUserAgent String?

  startDate    DateTime?
  deadlineDate DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol  Protocol  @relation(fields: [protocolId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  proposal  Proposal? @relation(fields: [proposalId], references: [id])
  createdBy User?     @relation("ContractCreatedBy", fields: [createdById], references: [id])

  payments        Payment[]
  billingCharges  BillingCharge[]
  fiscalDocuments FiscalDocument[]

  // Snapshot imutável das condições financeiras
  // aprovadas na proposta no momento da geração do contrato.
  paymentSchedule ContractPaymentSchedule[]

  // Prorrogações formais de vencimento.
  paymentDueDateExtensions PaymentDueDateExtension[]
}

model ContractPaymentSchedule {
  id Int @id @default(autoincrement())

  contractId Int

  type ProposalPaymentScheduleType

  // Entrada = 0.
  // Parcelas futuras = 1, 2, 3...
  installmentNumber Int

  // Quantidade de parcelas futuras.
  // Para entrada pode ser null.
  totalInstallments Int?

  // Valor canônico desta etapa em CENTAVOS.
  amountCents Int

  // Vencimento exatamente como aprovado na proposta.
  dueDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  dueDateExtensions PaymentDueDateExtension[]

  @@unique([contractId, type, installmentNumber])
  @@index([contractId])
  @@index([dueDate])
}

model PaymentDueDateExtension {
  id Int @id @default(autoincrement())

  contractId                Int
  contractPaymentScheduleId Int
  billingChargeId           Int?

  // Data que estava vigente no momento da prorrogação.
  previousDueDate DateTime

  // Novo vencimento formalmente autorizado.
  newDueDate DateTime

  // Justificativa obrigatória e auditável.
  justification String

  status PaymentDueDateExtensionStatus @default(ATIVA)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cancelledAt        DateTime?
  cancelledById      Int?
  cancellationReason String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  contractPaymentSchedule ContractPaymentSchedule @relation(fields: [contractPaymentScheduleId], references: [id], onDelete: Cascade)

  billingCharge BillingCharge? @relation(fields: [billingChargeId], references: [id], onDelete: SetNull)

  createdBy User? @relation("PaymentDueDateExtensionCreatedBy", fields: [createdById], references: [id])

  cancelledBy User? @relation("PaymentDueDateExtensionCancelledBy", fields: [cancelledById], references: [id])

  @@index([contractId])
  @@index([contractPaymentScheduleId])
  @@index([billingChargeId])
  @@index([status])
  @@index([newDueDate])
}

model BillingCharge {
  id Int @id @default(autoincrement())

  protocolId  Int?
  clientId    Int
  contractId  Int?
  createdById Int?

  // Vínculo 1:1 com a parcela/lancamento do Financeiro V2.
  // Impede que a mesma transação gere duas BillingCharge.
  financialTransactionId Int? @unique

  provider   BillingProvider   @default(BANCO_DO_BRASIL)
  status     BillingStatus     @default(AGUARDANDO_DOCUMENTO_FISCAL)
  chargeType BillingChargeType @default(ENTRADA)

  fiscalMode BillingFiscalMode @default(NOTA_FISCAL_ANTES)

  description String
  amount      Int

  // Financeiro V2: valor canônico da cobrança em centavos.
  // Quando preenchido, tem precedência sobre o campo legado amount.
  amountCents Int?

  dueDate DateTime

  installmentNumber Int?
  totalInstallments Int?

  externalId     String?
  nossoNumero    String?
  txid           String?
  pixKey         String?
  pixCopyPaste   String?
  pixQrCode      String?
  boletoUrl      String?
  linhaDigitavel String?
  barcode        String?

  paidAt     DateTime?
  paidAmount Int?

  sentToClientAt DateTime?

  // =====================================================
  // DOCUMENTO OFICIAL DE COBRANÇA / AUTENTICIDADE
  // =====================================================

  // Ex.: COB-2026-000123
  documentNumber String? @unique

  // Identificador não sequencial exibido no PDF.
  serialNumber String? @unique

  // Token público utilizado na página de verificação.
  publicToken String? @unique

  // SHA-256 dos dados canônicos da cobrança/documento.
  verificationHash String?

  documentPdfPath     String?
  documentGeneratedAt DateTime?

  // Evita envio duplicado da confirmação pós-pagamento.
  paymentConfirmationEmailSentAt DateTime?

  rawRequest  String?
  rawResponse String?
  rawWebhook  String?

  errorMessage String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol  Protocol? @relation(fields: [protocolId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  contract  Contract? @relation(fields: [contractId], references: [id])
  createdBy User?     @relation("BillingChargeCreatedBy", fields: [createdById], references: [id])

  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id])

  fiscalDocuments FiscalDocument[]

  dueDateExtensions PaymentDueDateExtension[]

  @@index([protocolId])
  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([provider])
  @@index([txid])
  @@index([externalId])
}

model FiscalDocument {
  id Int @id @default(autoincrement())

  protocolId      Int
  clientId        Int
  contractId      Int?
  billingChargeId Int?
  createdById     Int?

  type   FiscalDocumentType
  moment FiscalDocumentMoment
  status FiscalDocumentStatus @default(ANEXADO)

  number   String?
  issuedAt DateTime?
  amount   Int?

  fileName String
  filePath String
  mimeType String?
  size     Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol      Protocol       @relation(fields: [protocolId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  contract      Contract?      @relation(fields: [contractId], references: [id])
  billingCharge BillingCharge? @relation(fields: [billingChargeId], references: [id])
  createdBy     User?          @relation("FiscalDocumentCreatedBy", fields: [createdById], references: [id])

  @@index([protocolId])
  @@index([clientId])
  @@index([contractId])
  @@index([billingChargeId])
  @@index([type])
  @@index([moment])
}

model Payment {
  id                Int           @id @default(autoincrement())
  contractId        Int?
  protocolId        Int
  clientId          Int
  description       String
  amount            Float
  dueDate           DateTime
  paidDate          DateTime?
  status            PaymentStatus @default(PENDENTE)
  paymentMethod     String?
  installmentNumber Int?
  totalInstallments Int?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id])
  protocol Protocol  @relation(fields: [protocolId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])

  publicToken          String?   @unique
  provider             String?
  providerEnv          String?
  providerChargeId     String?
  txid                 String?
  pixCopiaECola        String?
  pixQrCode            String?
  boletoLinhaDigitavel String?
  boletoUrl            String?
  fiscalDocumentId     Int?
  fiscalMode           String?
  providerRaw          String?
  sentToClientAt       DateTime?
}

model PublicRequest {
  id                  Int                 @id @default(autoincrement())
  name                String
  phone               String?
  email               String?
  serviceTypeId       Int?
  message             String?
  status              PublicRequestStatus @default(NOVA)
  convertedToClient   Boolean             @default(false)
  convertedToProtocol Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id])
}

model NotificationLog {
  id            Int       @id @default(autoincrement())
  protocolId    Int?
  appointmentId Int?
  clientId      Int?
  type          String
  recipient     String
  subject       String?
  message       String?
  status        String
  sentAt        DateTime?
  errorMessage  String?

  createdAt DateTime @default(now())
}

model CompanySettings {
  id          Int     @id @default(autoincrement())
  companyName String  @default("AMAZONIKA Engenharia & Meio Ambiente")
  systemName  String  @default("SIS Amazonika")
  subtitle    String  @default("Gestão de Serviços Ambientais")
  email       String?
  alertEmail  String?
  phone       String?
  whatsapp    String?
  address     String?
  city        String?
  state       String?
  logoPath    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          Int     @id @default(autoincrement())
  userId      Int?
  userName    String?
  userEmail   String?
  userRole    String?
  action      String
  entity      String?
  entityId    String?
  description String?
  ipAddress   String?
  metadata    String?

  createdAt DateTime @default(now())
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  group     String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialCategory {
  id        Int                   @id @default(autoincrement())
  name      String
  type      FinancialCategoryType
  color     String?
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  transactions FinancialTransaction[]
  fixedCosts   FixedCost[]
  salaries     EmployeeSalary[]

  @@unique([name, type])
}

model FinancialTransaction {
  id Int @id @default(autoincrement())

  type   FinancialTransactionType
  source FinancialTransactionSource
  status FinancialTransactionStatus

  description String
  amount      Int

  dueDate         DateTime?
  paidAt          DateTime?
  competenceMonth String?

  clientName String?
  notes      String?

  // Cliente vinculado diretamente ao lançamento.
  // Necessário para cobrança automática e notificações.
  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  protocolId Int?
  protocol   Protocol? @relation(fields: [protocolId], references: [id])

  // Serviço selecionado diretamente do Catálogo Técnico-Comercial.
  catalogServiceId Int?
  catalogService   CatalogService? @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)

  // =====================================================
  // PARCELAMENTO
  // =====================================================

  // Mesmo identificador em todas as parcelas do serviço.
  installmentGroupId String?

  // Ex.: parcela 2 de 6.
  installmentNumber Int?
  totalInstallments Int?

  categoryId Int?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  createdById Int?
  createdBy   User? @relation("FinancialTransactionCreatedBy", fields: [createdById], references: [id])

  partnerCommission PartnerCommission?

  // Cobrança operacional/documental associada a este lançamento.
  billingCharge BillingCharge?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==================================================
  // COBRANÇA AUTOMÁTICA / PIX / WEBHOOK
  // ==================================================

  autoChargeEnabled Boolean @default(false)

  // Provedor responsável pela cobrança.
  // Ex.: BANCO_DO_BRASIL
  paymentProvider String?

  // Identificador da cobrança no provedor.
  providerChargeId String?

  // TXID Pix ou identificador equivalente.
  providerTxId String?

  // Estado da cobrança no provedor.
  // Ex.: PENDING, ACTIVE, PAID, EXPIRED, CANCELLED
  chargeStatus String?

  chargeCreatedAt DateTime?
  chargeExpiresAt DateTime?

  // Momento confirmado pelo banco/webhook.
  paymentConfirmedAt DateTime?

  // Controle de avisos automáticos.
  lastNotificationAt DateTime?
  notificationCount  Int       @default(0)

  // Último webhook válido recebido.
  webhookLastReceivedAt DateTime?

  @@index([clientId])
  @@index([catalogServiceId])
  @@index([installmentGroupId])
}

model EmployeeSalary {
  id              Int     @id @default(autoincrement())
  employeeName    String
  roleDescription String?
  amount          Int

  categoryId Int?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  dueDay Int     @default(5)
  active Boolean @default(true)

  notes String?

  createdById Int?
  createdBy   User? @relation("EmployeeSalaryCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FixedCost {
  id          Int    @id @default(autoincrement())
  description String
  amount      Int

  categoryId Int?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  dueDay Int
  active Boolean @default(true)

  notes String?

  createdById Int?
  createdBy   User? @relation("FixedCostCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FinancialCategoryType {
  RECEITA
  DESPESA
}

enum FinancialTransactionType {
  ENTRADA
  SAIDA
}

enum FinancialTransactionSource {
  CONTRATO
  SERVICO_AVULSO
  CUSTO_FIXO
  SALARIO
  COMISSAO_PARCEIRO
  IMPOSTO
  TAXA
  OUTRO
}

enum FinancialTransactionStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model ManagementCashSetting {
  id              Int     @id @default(autoincrement())
  competenceMonth String  @unique
  cashPercent     Float   @default(10)
  notes           String?

  createdById Int?
  createdBy   User? @relation("ManagementCashSettingCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProLaboreAdvance {
  id              Int    @id @default(autoincrement())
  managerUserId   Int
  competenceMonth String

  amount      Int
  paidAt      DateTime
  description String?
  notes       String?

  createdById Int?
  createdBy   User? @relation("ProLaboreAdvanceCreatedBy", fields: [createdById], references: [id])

  manager User @relation("ManagerProLaboreAdvances", fields: [managerUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id             Int    @id @default(autoincrement())
  proposalNumber String @unique

  protocolId  Int
  clientId    Int
  createdById Int?

  status ProposalStatus @default(RASCUNHO)

  title          String
  description    String?
  technicalScope String?

  paymentMode ProposalPaymentMode @default(ENTRADA_PARCELAS)

  totalAmount       Int  @default(0)
  entryAmount       Int  @default(0)
  installmentQty    Int?
  installmentAmount Int?

  executionDays Int?
  validUntil    DateTime?

  sentAt                DateTime?
  acceptedAt            DateTime?
  refusedAt             DateTime?
  adjustmentRequestedAt DateTime?

  clientMessage String?
  internalNotes String?

  publicToken String @unique

  rawSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol  Protocol @relation(fields: [protocolId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])
  createdBy User?    @relation("ProposalCreatedBy", fields: [createdById], references: [id])

  items           ProposalItem[]
  paymentSchedule ProposalPaymentSchedule[]
  contracts       Contract[]
}

model ProposalPaymentSchedule {
  id Int @id @default(autoincrement())

  proposalId Int

  type              ProposalPaymentScheduleType
  // 0 = entrada; 1..N = parcelas.
  installmentNumber Int
  totalInstallments Int?

  // Valor canônico desta etapa em CENTAVOS.
  amountCents Int

  dueDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, installmentNumber])
  @@index([proposalId])
  @@index([dueDate])
}

enum ProposalPaymentScheduleType {
  ENTRADA
  PARCELA
}

model ProposalItem {
  id Int @id @default(autoincrement())

  proposalId Int

  serviceName String
  description String?
  quantity    Int     @default(1)
  unitAmount  Int
  totalAmount Int

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model ProposalHistory {
  id Int @id @default(autoincrement())

  protocolId Int
  proposalId Int?

  eventType   String
  title       String
  description String?
  recipient   String?
  senderName  String?
  senderEmail String?

  metadata String?

  createdById Int?
  createdAt   DateTime @default(now())

  protocol Protocol @relation(fields: [protocolId], references: [id])

  @@index([protocolId])
  @@index([proposalId])
  @@index([eventType])
}

enum PartnerCommissionStatus {
  PREVISTA
  DISPONIVEL_PARA_PAGAMENTO
  PAGA
  CANCELADA
}

model Partner {
  id Int @id @default(autoincrement())

  name     String
  cpfCnpj  String?
  phone    String?
  whatsapp String?
  email    String?
  pixKey   String?

  defaultPercent Float
  active         Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions PartnerCommission[]

  @@index([name])
  @@index([active])
}

model PartnerCommission {
  id Int @id @default(autoincrement())

  partnerId  Int
  protocolId Int
  contractId Int?

  percent Float

  // Valores sempre em centavos.
  baseAmount       Int @default(0)
  commissionAmount Int @default(0)

  status PartnerCommissionStatus @default(PREVISTA)

  dueDate DateTime?
  paidAt  DateTime?

  financialTransactionId Int?                  @unique
  financialTransaction   FinancialTransaction? @relation(fields: [financialTransactionId], references: [id])

  notes String?

  partner  Partner   @relation(fields: [partnerId], references: [id])
  protocol Protocol  @relation(fields: [protocolId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, contractId])
  @@index([partnerId])
  @@index([protocolId])
  @@index([contractId])
  @@index([status])
}

// =========================================================
// PROPOSTAS AVULSAS
// =========================================================

enum StandaloneProposalStatus {
  RASCUNHO
  GERADA
  ENVIADA
  APROVADA_VERBALMENTE
  AGUARDANDO_ASSINATURA
  ASSINADA_ELETRONICAMENTE
  PDF_ASSINADO_ANEXADO
  RECUSADA
  EXPIRADA
  VINCULADA_PROTOCOLO
  CANCELADA
}

enum StandaloneProposalApprovalMode {
  NENHUM
  VERBAL
  PDF_ASSINADO
  ASSINATURA_ELETRONICA
}

enum StandaloneProposalAttachmentType {
  LISTADO
  ARQUIVO
}

enum StandaloneProposalSignatureStatus {
  PENDENTE
  ASSINADA
  EXPIRADA
  CANCELADA
}

model StandaloneProposal {
  id Int @id @default(autoincrement())

  proposalNumber String @unique
  publicToken    String @unique

  // Cliente existente é opcional.
  // Os campos abaixo preservam o snapshot do destinatário.
  clientId Int?

  clientName     String
  clientCpfCnpj  String?
  clientEmail    String?
  clientPhone    String?
  clientWhatsapp String?
  clientAddress  String?
  clientCity     String?
  clientState    String?

  createdById Int?

  status       StandaloneProposalStatus       @default(RASCUNHO)
  approvalMode StandaloneProposalApprovalMode @default(NENHUM)

  title      String
  objectText String?
  introText  String?
  scopeText  String?

  // Valores sempre em centavos.
  subtotalAmount Int @default(0)
  discountAmount Int @default(0)
  additionAmount Int @default(0)
  totalAmount    Int @default(0)

  paymentMode ProposalPaymentMode @default(ENTRADA_PARCELAS)

  entryAmount       Int     @default(0)
  installmentQty    Int?
  installmentAmount Int?
  paymentText       String?

  executionDays Int?
  executionText String?

  validUntil DateTime?

  notes         String?
  internalNotes String?

  // Arquivo original emitido pelo SIS.
  generatedPdfPath String?
  generatedPdfName String?
  generatedPdfHash String?

  // Arquivo devolvido assinado fisicamente/digitalmente,
  // sem sobrescrever o PDF original.
  signedPdfPath String?
  signedPdfName String?
  signedPdfHash String?

  generatedAt DateTime?
  sentAt      DateTime?

  verbalApprovedAt   DateTime?
  verbalApprovedBy   String?
  verbalApprovalNote String?

  signedPdfUploadedAt DateTime?

  // Quando convertida para o fluxo formal.
  linkedProtocolId    Int?
  convertedProposalId Int?

  linkedAt DateTime?

  rawSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client? @relation(fields: [clientId], references: [id])
  createdBy User?   @relation("StandaloneProposalCreatedBy", fields: [createdById], references: [id])

  items       StandaloneProposalItem[]
  attachments StandaloneProposalAttachment[]
  signatures  StandaloneProposalSignature[]
  events      StandaloneProposalEvent[]

  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@index([proposalNumber])
  @@index([publicToken])
  @@index([linkedProtocolId])
  @@index([convertedProposalId])
  @@index([createdAt])
}

model StandaloneProposalItem {
  id Int @id @default(autoincrement())

  proposalId Int

  // Referência opcional ao catálogo.
  // A proposta continuará íntegra mesmo se o catálogo mudar.
  catalogServiceId Int?

  catalogServiceCode String?
  categoryName       String?

  serviceName String

  acronym String?

  // Texto curto usado exclusivamente na tabela comercial do PDF.
  summaryDescription String?

  // Texto comercial detalhado exibido no corpo da proposta.
  commercialDescription String?

  // Campo legado preservado por compatibilidade.
  description String?

  // Conteúdo técnico detalhado do serviço.
  technicalDescription String?

  // Fundamentação legal, normativa e regulatória.
  legalText String?

  pricingMode CatalogPricingMode?

  quantity  Float   @default(1)
  unitLabel String?

  // Snapshot financeiro em centavos.
  catalogUnitAmount Int?
  unitAmount        Int
  totalAmount       Int

  manualPrice Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal StandaloneProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  catalogService CatalogService? @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([catalogServiceId])
  @@index([sortOrder])
}

model StandaloneProposalAttachment {
  id Int @id @default(autoincrement())

  proposalId Int

  type StandaloneProposalAttachmentType @default(LISTADO)

  title       String
  description String?

  // Pode existir apenas como item listado.
  // O arquivo é opcional.
  fileName String?
  filePath String?
  mimeType String?
  size     Int?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal StandaloneProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([sortOrder])
}

model StandaloneProposalSignature {
  id Int @id @default(autoincrement())

  proposalId Int

  publicToken String @unique

  status StandaloneProposalSignatureStatus @default(PENDENTE)

  expiresAt DateTime?

  signerName    String?
  signerCpfCnpj String?
  signerEmail   String?
  signerPhone   String?

  signedAt DateTime?

  signerIp        String?
  signerUserAgent String?

  // Hash do PDF que estava sendo aceito.
  documentHash String?

  // Texto mostrado no momento do aceite.
  consentText String?

  // Evidência adicional serializada.
  evidenceJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal StandaloneProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([status])
  @@index([expiresAt])
}

model StandaloneProposalEvent {
  id Int @id @default(autoincrement())

  proposalId Int

  eventType String
  title     String

  description String?

  actorUserId Int?
  actorName   String?
  actorEmail  String?

  recipient String?

  ipAddress String?
  userAgent String?

  metadata String?

  createdAt DateTime @default(now())

  proposal StandaloneProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([eventType])
  @@index([createdAt])
}

// =====================================================
// CRONOGRAMA OPERACIONAL DE CAMPO
// =====================================================

enum FieldScheduleType {
  GEORREFERENCIAMENTO
  TOPOGRAFIA
  DRONE
  INVENTARIO_FLORESTAL
  VISTORIA_AMBIENTAL
  LEVANTAMENTO_AMBIENTAL
  OUTRO
}

enum FieldScheduleStatus {
  PLANEJADO
  CONFIRMADO
  EM_DESLOCAMENTO
  EM_CAMPO
  CONCLUIDO
  ADIADO
  CANCELADO
}

enum FieldNotificationStatus {
  PENDENTE
  PROCESSANDO
  ENVIADO
  ERRO
  CANCELADO
}

model FieldSchedule {
  id Int @id @default(autoincrement())

  title       String
  description String?

  type   FieldScheduleType
  status FieldScheduleStatus @default(PLANEJADO)

  // Cliente / empreendimento / imóvel
  clientName   String?
  propertyName String?

  municipality String?
  state        String?

  location  String?
  reference String?

  // Coordenadas opcionais do destino.
  latitude  Float?
  longitude Float?

  // Período da atividade
  startDate DateTime
  endDate   DateTime?

  departureTime String?
  returnTime    String?

  meetingPoint String?

  // Configuração padrão do alerta.
  alertEnabled    Boolean @default(true)
  alertDaysBefore Int     @default(3)

  notes String?

  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managers      FieldScheduleManager[]
  notifications FieldScheduleNotification[]

  @@index([startDate])
  @@index([status])
  @@index([type])
  @@index([createdById])
}

model FieldScheduleManager {
  id Int @id @default(autoincrement())

  scheduleId Int
  userId     Int

  // Snapshot para preservar histórico.
  name  String
  email String

  createdAt DateTime @default(now())

  schedule FieldSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  notifications FieldScheduleNotification[]

  @@unique([scheduleId, userId])
  @@index([scheduleId])
  @@index([userId])
}

model FieldScheduleNotification {
  id Int @id @default(autoincrement())

  scheduleId Int
  managerId  Int

  daysBefore Int

  status FieldNotificationStatus @default(PENDENTE)

  scheduledFor DateTime
  sentAt       DateTime?

  recipientEmail String

  subject   String?
  messageId String?
  errorText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule FieldSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  manager FieldScheduleManager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, managerId, daysBefore])
  @@index([scheduledFor])
  @@index([status])
  @@index([scheduleId])
}
